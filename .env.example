# Telegram credentials from https://my.telegram.org/apps and @BotFather
API_ID=12345678
API_HASH=replace_with_api_hash
BOT_TOKEN=123456789:replace_with_bot_token

# FilePress API (get this key from your FilePress account)
FILEPRESS_API_KEY=replace_with_filepress_api_key
# API hostnames can change; override this if FilePress gives you a new endpoint.
FILEPRESS_API_URL=https://api.filebee.top/api/v1/file/add
FILEPRESS_BASE_URL=https://filepress.live

# Google Drive service account JSON file. Add its email to a Shared Drive.
GDRIVE_SERVICE_ACCOUNT_FILE=service-account.json
GDRIVE_FOLDER_ID=

# Local storage / runtime
DOWNLOAD_DIR=downloads
DATABASE_PATH=data/uploads.sqlite3
PORT=8080
LOG_LEVEL=INFO

# Telegram MTProto bot-side file ceiling (~2000 MiB). Do not increase this to claim 4 GB support.
TELEGRAM_MAX_FILE_SIZE_BYTES=2097152000
